# Copy to .env.local and fill in. Never commit real secrets.
# Variables are introduced milestone by milestone; see docs/adr/0006-environments-and-demo.md.

# ── Tenancy (M2) ─────────────────────────────────────────────────────────
# Root domain of the platform. Tenants live at {code}.<root> in subdomain mode.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# subdomain | path | single
TENANCY_MODE=path
# Only for TENANCY_MODE=single (demo deployment)
# DEFAULT_TENANT_CODE=demo

# ── Supabase (M1/M2) — `pnpm db:status` prints the local values ──────────
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose it with a NEXT_PUBLIC_ prefix.
# SUPABASE_SECRET_KEY=
# SEND_EMAIL_HOOK_SECRET=

# ── Email (M2) — smtp (Mailpit) | resend | disabled ───────────────────────
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM="Pauta Escolar <nao-responda@pauta.app>"
# RESEND_API_KEY=

# ── Web Push (M8) ────────────────────────────────────────────────────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ── Demo deployment (M8) ─────────────────────────────────────────────────
# NEXT_PUBLIC_DEMO_MODE=false
# DEMO_PASSWORD=

# ── Observability (M9) ───────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
